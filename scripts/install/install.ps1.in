# Installs smbs @@VERSION@@ from GitHub Releases. Generated by the release
# workflow from scripts/install/install.ps1.in; the SHA-256 hash below is the
# published archive's hash.
#
#   irm https://github.com/cpaikr/smbs/releases/latest/download/install.ps1 | iex
#
# Environment:
#   SMBS_INSTALL_DIR   install directory (default: %LOCALAPPDATA%\smbs\bin)
#   SMBS_ARCHIVE_DIR   read the archive from this directory instead of
#                      downloading it (used by release verification)
# Everything runs in a child scope so `iex` leaves the caller's session alone.
& {
    $ErrorActionPreference = 'Stop'
    $version = '@@VERSION@@'
    $target = 'windows-x64-msvc'
    $sha256 = '@@SHA256_windows-x64-msvc@@'
    $archive = "smbs-$version-$target.zip"
    $url = "https://github.com/cpaikr/smbs/releases/download/v$version/$archive"

    $machine = $env:PROCESSOR_ARCHITECTURE
    if ($env:PROCESSOR_ARCHITEW6432) { $machine = $env:PROCESSOR_ARCHITEW6432 }
    if ($machine -ne 'AMD64') {
        throw "smbs install: no prebuilt binary for Windows $machine; build from source with cargo instead."
    }

    $installDir = $env:SMBS_INSTALL_DIR
    if (-not $installDir) { $installDir = Join-Path $env:LOCALAPPDATA 'smbs\bin' }

    $temporary = $null
    $work = Join-Path ([System.IO.Path]::GetTempPath()) ("smbs-install-" + [guid]::NewGuid())
    New-Item -ItemType Directory -Path $work | Out-Null
    try {
        $download = Join-Path $work $archive
        if ($env:SMBS_ARCHIVE_DIR) {
            Copy-Item -LiteralPath (Join-Path $env:SMBS_ARCHIVE_DIR $archive) -Destination $download
        } else {
            $ProgressPreference = 'SilentlyContinue'
            Invoke-WebRequest -Uri $url -OutFile $download -UseBasicParsing
        }

        $actual = (Get-FileHash -LiteralPath $download -Algorithm SHA256).Hash.ToLowerInvariant()
        if ($actual -ne $sha256) {
            throw "smbs install: checksum mismatch for $archive (expected $sha256, got $actual)."
        }

        $extract = Join-Path $work 'extract'
        Expand-Archive -LiteralPath $download -DestinationPath $extract
        $staged = Join-Path $extract 'smbs.exe'
        if (-not (Test-Path -LiteralPath $staged -PathType Leaf)) {
            throw "smbs install: $archive does not contain smbs.exe."
        }
        & $staged --version | Out-Null
        if ($LASTEXITCODE -ne 0) { throw 'smbs install: the downloaded binary does not run on this system.' }

        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        # Copy next to the destination, then rename over it. Renaming fails
        # while smbs.exe is running; the finally block removes the copy then.
        $temporary = Join-Path $installDir ".smbs.install.$PID.exe"
        Copy-Item -LiteralPath $staged -Destination $temporary -Force
        Move-Item -LiteralPath $temporary -Destination (Join-Path $installDir 'smbs.exe') -Force

        Write-Host "Installed smbs $version to $(Join-Path $installDir 'smbs.exe')"
        $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
        if (-not (($userPath -split ';') -contains $installDir)) {
            $quoted = $installDir.Replace("'", "''")
            Write-Host "$installDir is not on your user PATH. To add it permanently (then open a new terminal):"
            Write-Host "  [Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path', 'User') + ';$quoted', 'User')"
        }
    } finally {
        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
        if ($temporary) { Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue }
    }
}
