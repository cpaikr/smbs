#!/bin/sh
# Installs smbs @@VERSION@@ from GitHub Releases. Generated by the release
# workflow from scripts/install/install.sh.in; the SHA-256 hashes below are
# the published archives' hashes.
#
#   curl -fsSL https://github.com/cpaikr/smbs/releases/latest/download/install.sh | sh
#
# Needs: curl or wget, tar, and sha256sum or shasum.
# Environment:
#   SMBS_INSTALL_DIR   install directory (default: $HOME/.local/bin)
#   SMBS_ARCHIVE_DIR   read archives from this directory instead of
#                      downloading them (used by release verification)
#
# Everything runs inside main(), called on the last line, so a truncated
# download cannot run part of the script.
set -eu

fail() {
  printf 'smbs install: %s\n' "$1" >&2
  exit 1
}

detect_target() {
  kernel="$(uname -s)"
  machine="$(uname -m)"
  # A shell under Rosetta reports x86_64 on Apple silicon.
  if [ "$kernel" = Darwin ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ]; then
    machine=arm64
  fi
  case "${kernel}/${machine}" in
    Linux/x86_64 | Linux/amd64) target="linux-x64-gnu" sha256="@@SHA256_linux-x64-gnu@@" ;;
    Linux/aarch64 | Linux/arm64) target="linux-arm64-gnu" sha256="@@SHA256_linux-arm64-gnu@@" ;;
    Darwin/arm64) target="darwin-arm64" sha256="@@SHA256_darwin-arm64@@" ;;
    *) fail "no prebuilt binary for ${kernel} ${machine}; build from source with cargo instead." ;;
  esac
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum < "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 < "$1" | cut -d ' ' -f 1
  else
    fail "sha256sum or shasum is required to verify the download."
  fi
}

# A JSON string literal for $1 (escapes backslashes and double quotes).
json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

main() {
  version="@@VERSION@@"
  base_url="https://github.com/cpaikr/smbs/releases/download/v${version}"
  detect_target
  archive="smbs-${version}-${target}.tar.gz"
  install_dir="${SMBS_INSTALL_DIR:-${HOME:?HOME is not set}/.local/bin}"

  workdir="$(mktemp -d)"
  partial=""
  # Clean up on every exit; turn signals into exits so cleanup runs once.
  trap 'rm -rf "$workdir"; [ -z "$partial" ] || rm -f "$partial"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if [ -n "${SMBS_ARCHIVE_DIR:-}" ]; then
    cp "${SMBS_ARCHIVE_DIR}/${archive}" "${workdir}/${archive}" || fail "${archive} is not in ${SMBS_ARCHIVE_DIR}."
  elif command -v curl >/dev/null 2>&1; then
    curl -fsSL "${base_url}/${archive}" -o "${workdir}/${archive}" || fail "download failed: ${base_url}/${archive}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${base_url}/${archive}" -O "${workdir}/${archive}" || fail "download failed: ${base_url}/${archive}"
  else
    fail "curl or wget is required."
  fi

  actual="$(sha256_of "${workdir}/${archive}")"
  [ "$actual" = "$sha256" ] || fail "checksum mismatch for ${archive} (expected ${sha256}, got ${actual})."

  mkdir "${workdir}/extract"
  tar -xzf "${workdir}/${archive}" -C "${workdir}/extract"
  staged="${workdir}/extract/smbs"
  [ -f "$staged" ] || fail "${archive} does not contain smbs."
  chmod 755 "$staged"
  "$staged" --version >/dev/null 2>&1 || fail "the downloaded binary does not run on this system."

  # json_string escapes quotes and backslashes only; JSON forbids raw control
  # characters, so such a path could not get a valid receipt. Checked before
  # anything is installed.
  case "$install_dir" in
    *[[:cntrl:]]*) fail "the install directory contains control characters; choose another SMBS_INSTALL_DIR." ;;
  esac
  mkdir -p "$install_dir"
  # Copy next to the destination, then rename: the swap is atomic.
  partial="${install_dir}/.smbs.install.$$"
  cp "$staged" "$partial"
  mv -f "$partial" "${install_dir}/smbs"
  partial=""

  # The receipt lets `smbs upgrade` recognize this binary as installer-managed.
  executable="$(CDPATH='' cd -P -- "$install_dir" >/dev/null && pwd -P)/smbs"
  partial="${install_dir}/.smbs-receipt.install.$$"
  printf '{"schemaVersion":1,"version":%s,"target":%s,"executable":%s,"source":%s,"sha256":%s}\n' \
    "$(json_string "$version")" "$(json_string "$target")" "$(json_string "$executable")" \
    '"https://github.com/cpaikr/smbs/releases"' \
    "$(json_string "$(sha256_of "${install_dir}/smbs")")" > "$partial"
  mv -f "$partial" "${install_dir}/.smbs-receipt.json"
  partial=""
  # Files an interrupted `smbs upgrade` may have left behind.
  rm -f "${install_dir}"/.smbs-new-* "${install_dir}"/.smbs-old-* "${install_dir}"/.smbs-receipt-new-*

  printf 'Installed smbs %s to %s/smbs\n' "$version" "$install_dir"
  case ":${PATH}:" in
    *":${install_dir}:"*) ;;
    *)
      printf '%s is not on PATH. For this shell:\n' "$install_dir"
      # shellcheck disable=SC2016 # $PATH is meant literally in the hint.
      printf '  export PATH="%s:$PATH"\n' "$install_dir"
      printf 'To keep it, add that line to your shell profile (~/.profile, ~/.bashrc, or ~/.zshrc).\n'
      ;;
  esac
}

main "$@"
